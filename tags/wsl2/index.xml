	height=&#34;1302&#34;
	srcset=&#34;https://lingsir007.netlify.app/p/wsl2--docker--tensorflow%E4%BB%8E%E7%8E%AF%E5%A2%83%E6%90%AD%E5%BB%BA%E5%88%B0-stm32f407-%E6%A8%A1%E5%9E%8B%E9%83%A8%E7%BD%B2%E5%AE%8C%E6%95%B4%E6%95%99%E7%A8%8B/%E6%9C%80%E7%BB%88%E8%AE%AD%E7%BB%83%E7%BB%93%E6%9E%9C_hu_9dccb60eaf6caed6.png 480w, https://lingsir007.netlify.app/p/wsl2--docker--tensorflow%E4%BB%8E%E7%8E%AF%E5%A2%83%E6%90%AD%E5%BB%BA%E5%88%B0-stm32f407-%E6%A8%A1%E5%9E%8B%E9%83%A8%E7%BD%B2%E5%AE%8C%E6%95%B4%E6%95%99%E7%A8%8B/%E6%9C%80%E7%BB%88%E8%AE%AD%E7%BB%83%E7%BB%93%E6%9E%9C_hu_1007a183d6b76a46.png 1024w&#34;
	loading=&#34;lazy&#34;
	
		alt=&#34;最终训练结果&#34;
	
	
		class=&#34;gallery-image&#34; 
